{
  "name": "poppyshuffle-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for PoppyShuffle — open-source event & rental management for The Poppy Creative.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.poppycreates.poppyshuffle",
    "productName": "PoppyShuffle",
    "files": [
      "main.js",
      "preload.js",
      "../index.html",
      "../css/**/*",
      "../js/**/*",
      "../icons/**/*",
      "../embed/**/*",
      "../manifest.webmanifest"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
